{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ledger.schema.json",
  "title": "업무 원장 한 행 (v0.2)",
  "description": "원장 원본 필드와, 판정기가 읽는 태그(tags)를 분리한 구조. 작성자·조직 식별 정보는 이 스키마에 없다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_code",
    "activity",
    "hours_per_month",
    "input",
    "logic",
    "output",
    "tags"
  ],
  "properties": {
    "schema_version": { "const": "0.2" },
    "id": { "type": "string", "pattern": "^WL-[0-9]{4}$" },
    "source_code": { "type": "string", "pattern": "^ACT-[0-9A-Za-z-]+$" },
    "activity": { "type": "string", "minLength": 1 },
    "hours_per_month": { "type": "number", "minimum": 0 },
    "input": { "type": "string", "minLength": 1 },
    "logic": { "type": "string", "minLength": 1 },
    "output": { "type": "string", "minLength": 1 },
    "data_sources": { "type": "string" },
    "declared_reduction_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "human_role_reason": { "type": "string" },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure", "judgment", "sensitivity", "approval", "status"],
      "properties": {
        "structure": { "enum": ["정형", "반정형", "비정형"] },
        "judgment": { "enum": ["없음", "일부", "핵심"] },
        "sensitivity": { "enum": ["낮음", "중간", "높음"] },
        "approval": { "enum": ["없음", "조건부", "필수"] },
        "status": { "enum": ["초안", "확인"] }
      }
    },
    "note": { "type": "string" }
  }
}
